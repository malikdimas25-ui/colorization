import cv2
import numpy as np

# Загружаем исходное видео
input_path = "VID_20250827_135347_255.mp4"
output_path = "VID_20250827_135347_255_colorized.mp4"

cap = cv2.VideoCapture(input_path)

# Параметры исходного видео
fps = int(cap.get(cv2.CAP_PROP_FPS))
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

# Кодек и выходное видео
fourcc = cv2.VideoWriter_fourcc(*"mp4v")
out = cv2.VideoWriter(output_path, fourcc, fps, (width, height))

# Загружаем предобученную модель для колоризации (OpenCV DNN)
net = cv2.dnn.readNetFromCaffe(
    "models/colorization_deploy_v2.prototxt",
    "models/colorization_release_v2.caffemodel"
)

pts = np.load("models/pts_in_hull.npy")
class8 = net.getLayerId("class8_ab")
conv8 = net.getLayerId("conv8_313_rh")
net.getLayer(class8).blobs = [pts.transpose().reshape(2, 313, 1, 1)]
net.getLayer(conv8).blobs = [np.full([1, 313], 2.606, np.float32)]

while True:
    ret, frame = cap.read()
    if not ret:
        break

    img_rgb = (frame.astype("float32") / 255.0)
    img_lab = cv2.cvtColor(img_rgb, cv2.COLOR_BGR2Lab)
    img_l = img_lab[:, :, 0]

    img_l_resized = cv2.resize(img_l, (224, 224))
    img_l_resized -= 50
    net.setInput(cv2.dnn.blobFromImage(img_l_resized))
    ab_dec = net.forward()[0, :, :, :].transpose((1, 2, 0))

    ab_dec_us = cv2.resize(ab_dec, (frame.shape[1], frame.shape[0]))
    img_lab_out = np.concatenate((img_l[:, :, np.newaxis], ab_dec_us), axis=2)
    img_bgr_out = cv2.cvtColor(img_lab_out, cv2.COLOR_Lab2BGR)
    img_bgr_out = np.clip(img_bgr_out, 0, 1)

    out.write((255 * img_bgr_out).astype("uint8"))

cap.release()
out.release()
print("Готово! Сохранено как:", output_path)
